# stages-lab environment. Copy to .env and fill in generated values.
# .env is gitignored: never commit it.
#
#   cp .env.example .env
#   sed -i "s|^JWT_SECRET=.*|JWT_SECRET=$(openssl rand -hex 32)|" .env
#   sed -i "s|^POSTGRES_PASSWORD=.*|POSTGRES_PASSWORD=$(openssl rand -hex 16)|" .env
#   sed -i "s|^APP_DB_PASSWORD=.*|APP_DB_PASSWORD=$(openssl rand -hex 16)|" .env

APP_ENV=production
DEBUG=false

# The app refuses to start in production while this is the placeholder.
JWT_SECRET=change-me-before-production

# The address of the proxy in front. Empty is a refusal to start in production:
# without it every client address in the logs is the proxy's own.
FORWARDED_ALLOW_IPS=127.0.0.1

# Owner role: owns the schema, runs migrations. Never used by the app.
POSTGRES_DB=stages
POSTGRES_USER=stages_owner
POSTGRES_PASSWORD=generate-me

# Restricted role: what the app connects with. SELECT and INSERT on audit_log,
# and nothing more there.
APP_DB_ROLE=stages_app
APP_DB_PASSWORD=generate-me

# The app connects as the restricted role...
DATABASE_URL=postgresql+psycopg://stages_app:generate-me@db:5432/stages
# ...and migrations as the owner.
MIGRATION_DATABASE_URL=postgresql+psycopg://stages_owner:generate-me@db:5432/stages

UPLOADS_DIR=/app/uploads
