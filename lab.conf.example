# lab.conf — everything environment-specific lives here, so no challenge ever
# hard-codes a path. Copy to lab.conf and edit. lab.conf is gitignored.
#
# One assignment per line, deliberately: a sed on a line holding two of them
# silently deletes the second, and `lab doctor` then reports an empty value you
# never touched. That is how it was found.
#
#   cp lab.conf.example lab.conf

# URLs use 127.0.0.1 rather than localhost on purpose: every container here
# publishes to the loopback IPv4 address only, and "localhost" resolves to ::1
# first on a dual-stack VM, which turns every check into a retry.
RUN_MODE="compose"            # the default, for anything without its own mode

# The lab does not run all three apps the same way, on purpose:
#   stages  ships its own compose.yaml, because this repo wrote it — and it is
#           therefore the app s4-04 uses, being the only one with genuinely
#           published container ports
#   leaves  gunicorn under systemd, which is what its own README_VPS.md assumes
#   nurse   gunicorn under systemd too, which is what its deployment/ docs
#           assume. Neither public repo ships a Dockerfile or a compose file, so
#           containerising them is a graded mission (s6-02, s6-07) rather than
#           something setup does for you invisibly and untested.
STAGES_MODE="compose"
LEAVES_MODE="systemd"
NURSE_MODE="systemd"

# --- the three apps ---------------------------------------------------------
# STAGES_DIR points at the stand-in app by default (see stages-lab/README.md).
# Point it at the real private app later without touching any challenge.
STAGES_DIR="/opt/stages"
STAGES_URL="http://127.0.0.1:8080/"
LEAVES_DIR="/opt/leaves"
LEAVES_URL="http://127.0.0.1:8081/etoile-formation-conge/"
NURSE_DIR="/opt/nurse"
NURSE_API="http://127.0.0.1:8000/api/health/"
NURSE_WEB="http://127.0.0.1:3000/"           # the host nginx block serving dist/
DB_SERVICE="db"
BACKUP_DIR="/var/backups/lab"

# --- compose mode -----------------------------------------------------------
# Compose project name per app, and the service name for each role.
STAGES_PROJECT="stages"
STAGES_WEB="web"
STAGES_API="api"
LEAVES_PROJECT="leaves"
LEAVES_WEB="web"
LEAVES_API="web"
NURSE_PROJECT="nurse"
NURSE_WEB_SVC="web"
NURSE_API_SVC="api"

# --- systemd mode -----------------------------------------------------------
# Unit name per app and role. Only read when RUN_MODE="systemd".
STAGES_WEB_UNIT="stages-web.service"
STAGES_API_UNIT="stages-api.service"
LEAVES_WEB_UNIT="leaves.service"
LEAVES_API_UNIT="leaves.service"
# Empty on purpose: the built frontend is static files served by the host
# nginx, so there is no unit for it. Set it if you containerise nurse in s6-07.
NURSE_WEB_UNIT=""
NURSE_API_UNIT="nurse-api.service"
DB_UNIT="postgresql.service"
NGINX_UNIT="nginx.service"

# --- host facts -------------------------------------------------------------
# The VM's own LAN address. Needed by the networking challenges, which must
# reach the VM as a laptop would rather than over loopback. Leave empty and
# those challenges will tell you to set it.
LAB_LAN_IP=""

# Virtual hosts the host nginx answers on. Invented names under .invalid, which
# is reserved and can never resolve publicly. Put them in /etc/hosts on the VM
# and on your laptop, pointing at LAB_LAN_IP. See SETUP.md section 8.
STAGES_VHOST="stages.lab.invalid"
LEAVES_VHOST="conge.lab.invalid"
NURSE_VHOST="theses.lab.invalid"

# --- seed volumes -----------------------------------------------------------
# Why these numbers: SETUP.md section 9. Shrink them on a small VM, but read
# that section first — s9-02 and s9-03 stop being measurable below roughly a
# tenth of SEED_PLACEMENTS.
SEED_TRAINEES="400"
SEED_PLACEMENTS="60000"
SEED_AUDIT="5000"
SEED_THESES="3000"
SEED_LEAVE_REQUESTS="60"

# Bulk seed targets, pinned to the models these two repos actually ship.
#   leaves v3.0  project leave_management_project, app leave_management
#   nurse        project config, app theses
# seed.sh still falls back to introspection, and still prints every model it
# found and stops rather than guessing, if a tag moves these.
LEAVES_SEED_MODEL="LeaveRequest"
NURSE_SEED_MODEL="Thesis"

# WSGI entry points, which differ between the two.
LEAVES_WSGI="leave_management_project.wsgi:application"
NURSE_WSGI="config.wsgi:application"

# --- the bash and log missions (stage 2) ------------------------------------
# Where the scripts you write in s2-02 and s2-03 have to live, so the checks
# know what to run. Anywhere on PATH; /usr/local/bin is the conventional place
# for something hand-written that is not managed by a package.
S2_BIN_DIR="/usr/local/bin"
# s2-01: the access log the questions are asked about, generated by its break.sh
# into a directory of its own, and the answers file you fill in.
S2_01_DIR="/var/tmp/lab-s2-01"
S2_01_LINES="50000"                            # how many lines to generate
# s2-03: the app the check stops to prove appcheck.sh notices. Any of the three.
S2_03_STOP_APP="leaves"
# s2-04: the log the logrotate rule has to cover. SETUP.md section 6 points
# gunicorn's access log here on purpose — not at the journal, which cannot be
# rotated and would make the mission vacuous.
LEAVES_LOG="/var/log/leaves/access.log"
S2_04_KEEP="7"                                 # rotations the rule must keep
S2_04_LOGROTATE_CONF="/etc/logrotate.d/leaves" # where the rule goes

# --- paths and endpoints the stage 3 challenges need ------------------------
# Verify these against your VM after SETUP.md; they are the only things the
# stage 3 checks assume about where configuration lives.
LEAVES_ENV="/etc/leaves/leaves.env"          # EnvironmentFile= of the unit
LEAVES_STATIC_ROOT="/opt/leaves/staticfiles" # STATIC_ROOT after collectstatic
LEAVES_CSS="static/admin/css/base.css"       # relative to LEAVES_URL; Django always ships it
NURSE_ENV="/etc/nurse/nurse.env"             # EnvironmentFile= of the unit
NURSE_LIST="http://127.0.0.1:8000/api/theses/"   # the list endpoint; confirm the route
STAGES_UPLOADS_VOLUME="stages_uploads"       # docker volume name, from `docker volume ls`
DEV_USER="dev1"                              # the over-privileged account in s3-07

# How long any single assertion may take before it is failed as timed out.
# A hang is a drill abandoned; a failure is information. Raise it on a slow VM.
ASSERT_TIMEOUT="30"

# --- bounded filesystems for the stage 5 resource drills --------------------
# The exhaustion challenges run on their own loopback filesystems so a break
# cannot fill a volume that matters, and so reset is a reformat rather than a
# traversal. lib/fs.sh creates and destroys these on demand; nothing persists
# between challenges except the empty filesystem a reset leaves mounted. Each
# brief names the mount it affects.
LAB_SCRATCH_DIR="/var/lib/breakfix-lab"      # where the images live
LAB_SCRATCH_MNT="/srv/lab-scratch"           # parent of every lab mount point
S5_UPLOADS_MB="512"                          # s5-01: the filesystem that fills
S5_LOGS_MB="512"                             # s5-03: the log volume
S5_SPOOL_MB="64"                             # s5-02: small, and starved of...
S5_SPOOL_INODES="2048"                       # ...inodes, so it exhausts in seconds
S5_SURVIVE_SECONDS="180"                     # s5-04: the window the app must survive
S5_MEM_FLOOR_MB="256"                        # s5-04: a memory limit below this is the fault
S5_HOG_MB="256"                              # s5-04: the red herring, bounded so it cannot eat the host
S5_HOG_NAME="indexer-warmup"                 # s5-04: the name it runs under
S5_SPIN_NAME="apt-cache-gen"                 # s5-05: the name the loops run under
LEAVES_PORT="8081"                           # s5-06: the port the service must own
S5_DECOY_NAME="telemetry-agent"              # s5-06: the name the squatter runs under
NGINX_SITE="/etc/nginx/sites-available/lab"  # s5-08: the host nginx site file
LAB_JOB_DIR="/opt/lab-jobs"                  # s5-09: where the nightly job lives
LAB_JOB_OUT="/var/lib/lab-jobs/report.csv"   # s5-09: what it is supposed to produce
LAB_JOB_MAX_AGE_H="30"                       # s5-09: older than this is "stopped"
FSTAB="/etc/fstab"                           # s5-07: named so nothing hard-codes it

# --- what "healthy" means ---------------------------------------------------
# health_check in lib/assert.sh reads these, and both `lab chaos --check` and
# the stage 8 acceptance suite call health_check, so this is the single place
# the definition lives. SETUP.md section 10 captures the port and user lists
# from the machine itself, which is the only version of these two worth having:
# a list copied from this example asserts that the example was right.
HEALTH_DISK_PCT="80"
HEALTH_INODE_PCT="80"
HEALTH_MEM_MIN_MB="256"
HEALTH_LOAD_PER_CORE="2.0"
# ss -ltnH | awk '{n=split($4,a,":"); print a[n]}' | sort -un | tr '\n' ' '
EXPECTED_PORTS="22 80 443 3000 5432 8000 8080 8081"
# awk -F: '$3>=1000 && $3<65534 {print $1}' /etc/passwd | tr '\n' ' '
EXPECTED_USERS=""
# Written by the backup timer in s7-01. Absent until then, which health_check
# reports rather than failing on.
BACKUP_MARKER="/var/backups/lab/last-success"
BACKUP_MAX_AGE_H="30"

# --- backups (stage 7) ------------------------------------------------------
# "Off-VM" is simulated locally throughout: a separate filesystem, a second
# container, or a second VM — never a real cloud account. The pattern is what
# is being learned, not the vendor. BACKUP_REMOTE is the off-site copy; keeping
# it on its own filesystem means a full local disk cannot take it with it.
BACKUP_TOOL="restic"
BACKUP_REPO="/var/backups/lab/repo"            # the local repository
BACKUP_REMOTE_MNT="/srv/lab-offsite"           # its own filesystem
BACKUP_REMOTE="/srv/lab-offsite/repo"          # the off-VM copy
BACKUP_REMOTE_MB="1024"                        # size of that filesystem
BACKUP_PASSWORD_FILE="/etc/lab-backup/password"
BACKUP_TIMER="lab-backup.timer"
BACKUP_SERVICE="lab-backup.service"
BACKUP_RETENTION_DAILY="7"
# Where whatever checks the backups writes its alerts. The check for s7-01 and
# s7-05 asserts a NEW line appears here, so it must be a file that is appended
# to, not a journal unit.
BACKUP_ALERT_LOG="/var/log/lab-backup-alerts.log"
# The restore fingerprint: row counts taken at backup time, compared after a
# restore. A restore that returns the wrong data silently is the failure mode.
BACKUP_FINGERPRINT="/var/backups/lab/row-counts.txt"
# What watches the marker and writes those alerts, and where a restore drill
# puts the copy it restores. Named here rather than left to the defaults in
# s7-01, s7-02 and s7-05, because nothing in this lab hard-codes a name.
BACKUP_WATCH_SERVICE="lab-backup-watch.service"
STAGES_DRILL_DB="stages_drill"                 # s7-02: the throwaway restore target
POSTGRES_USER="stages_owner"                   # the stages database owner
POSTGRES_DB="stages"                           # the live stages database
# What the ransomware drill scrambles and the restore has to bring back.
UPLOADS_PATH=""                                # from: docker volume inspect -f '{{.Mountpoint}}' stages_uploads

# --- containers and deployment (stage 6) -----------------------------------
# s6-02 and s6-07 move leaves and nurse from gunicorn-under-systemd into
# compose projects. When you pass one, flip that app's *_MODE above to
# "compose" — lib/svc.sh reads it, and every other challenge that touches the
# app then goes through the compose path instead of systemctl.
#
# The databases these two apps use on the host, which the compose stacks take
# over. Needed by the checks to dump, restore and count.
LEAVES_DB_NAME="leaves"
LEAVES_DB_ROLE="leaves_app"
NURSE_DB_NAME="nurse"
NURSE_DB_ROLE="nurse_app"
# A table in each whose row count is worth comparing across a rebuild. Django
# names tables <app_label>_<modelname>, lowercased.
LEAVES_COUNT_TABLE="leave_management_leaverequest"
NURSE_COUNT_TABLE="theses_thesis"
# s6-06: where the deploy script and the tag record live. The challenge is
# about naming a tag and getting exactly that tag, so the record of what is
# deployed has to live outside the checkout.
S6_06_DEPLOY_STATE="/var/lib/breakfix-lab/deployed-tags"
S6_06_APP="leaves"                             # the app the tag drill runs against

# --- the three rebuilds (stage 8) -------------------------------------------
# The acceptance suite in lib/accept.sh reads these. It is the same suite for
# all three, so anything set here is a standard the machine is held to however
# it was built.
#
# The admin account you create in s8-01: the suite checks that it exists, that
# it has keys, and that it can escalate. Unset is a failure rather than a skip,
# because "who can log into this machine" is not a detail of the capstone.
LAB_ADMIN_USER=""
# Where the suite restores the archive to in order to read it back. Scratch;
# removed and recreated on every run, so never point it at anything real.
S8_RESTORE_TARGET="/var/tmp/s8-restore"
# s8-02: your recovery time objective, in minutes — the number you wrote down
# in the s7-02 report, before you knew how long it would really take. The check
# compares the rebuild against it and reports the gap either way.
S8_RTO_MINUTES=""
# s8-03: your own runbooks, in a Git repository of their own. The blind rebuild
# is scored on what you had to add to them, so the check needs to see the
# commits you made during it.
S8_RUNBOOK_DIR=""

# --- networking and hardening (stage 4) -------------------------------------
SSH_PORT="22"                                  # s4-06 changes this, on purpose
TLS_MIN_DAYS="14"                              # s4-03: a certificate with less left is the fault
RESOLV_CONF="/etc/resolv.conf"                 # s4-02
RESOLVED_CONF="/etc/systemd/resolved.conf"     # s4-02, on a systemd-resolved host
# A name the apps resolve to reach their database. On this lab that is the
# compose service name from inside the stages network.
DB_HOSTNAME="db"
LYNIS_BASELINE="/var/lib/breakfix-lab/lynis-baseline.txt"   # s4-05 records the first score here

# TLS, recorded in section 8 of SETUP.md so s4-03 knows what to swap out.
TLS_CERT="/etc/nginx/tls/lab.crt"
TLS_KEY="/etc/nginx/tls/lab.key"

# Port the throwaway smoke-test challenge serves on. Any free high port.
SMOKE_PORT="18099"
S4_04_PORT="9090"                              # s4-04: the port published for the demonstration
S4_06_NEW_PORT="2222"                          # s4-06: where the unfinished change moved SSH

# --- chaos, load and intermittent faults (stage 9) --------------------------
S9_01_REQUESTS="100"                           # consecutive requests that must all succeed
S9_02_CONCURRENCY="20"                         # load level for the p95 assertion
S9_02_DURATION="20"                            # seconds of load
S9_02_P95_MAX="1.0"                            # seconds; above this is the fault
S9_03_WINDOW="120"                             # seconds to measure a growth rate over
S9_03_MAX_KB_PER_MIN="64"                      # growth above this is the fault
S9_04_MIN_UPTIME="300"                         # seconds a service must have been up
S9_01_DEAD_PORT="8009"                         # s9-01: the upstream member with nothing on it
S9_07_INDEX="ix_placements_ward_started"       # s9-07: the index that gets dropped
S9_03_MB="512"                                 # s9-03: size of the filesystem that fills
S9_04_INTERVAL="110"                           # s9-04: seconds between kills
S9_04_WATCH="180"                              # s9-04: seconds to watch the counter
S9_05_TZ="Europe/Tunis"                        # s9-05: the timezone the change moves to
