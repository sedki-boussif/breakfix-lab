# lab.conf — everything environment-specific lives here, so no challenge ever
# hard-codes a path. Copy to lab.conf and edit. lab.conf is gitignored.
#
#   cp lab.conf.example lab.conf

RUN_MODE="compose"            # the default, for anything without its own mode

# The lab does not run all three apps the same way, on purpose:
#   stages  ships its own compose.yaml (the stand-in)
#   leaves  starts as gunicorn under systemd, so s6-02 has work to do
#   nurse   runs in containers, so s4-04 has a published port to argue about
STAGES_MODE="compose"
LEAVES_MODE="systemd"
NURSE_MODE="compose"

# --- the three apps ---------------------------------------------------------
# STAGES_DIR points at the stand-in app by default (see stages-lab/README.md).
# Point it at the real private app later without touching any challenge.
STAGES_DIR="/opt/stages";  STAGES_URL="http://localhost:8080/"
LEAVES_DIR="/opt/leaves";  LEAVES_URL="http://localhost:8081/etoile-formation-conge/"
NURSE_DIR="/opt/nurse";    NURSE_API="http://localhost:8000/api/health/"
NURSE_WEB="http://localhost:3000/"
DB_SERVICE="db"
BACKUP_DIR="/var/backups/lab"

# --- compose mode -----------------------------------------------------------
# Compose project name per app, and the service name for each role.
STAGES_PROJECT="stages"; STAGES_WEB="web"; STAGES_API="api"
LEAVES_PROJECT="leaves"; LEAVES_WEB="web"; LEAVES_API="web"
NURSE_PROJECT="nurse";   NURSE_WEB_SVC="web"; NURSE_API_SVC="api"

# --- systemd mode -----------------------------------------------------------
# Unit name per app and role. Only read when RUN_MODE="systemd".
STAGES_WEB_UNIT="stages-web.service"; STAGES_API_UNIT="stages-api.service"
LEAVES_WEB_UNIT="leaves.service";     LEAVES_API_UNIT="leaves.service"
NURSE_WEB_UNIT="nurse-web.service";   NURSE_API_UNIT="nurse-api.service"
DB_UNIT="postgresql.service"
NGINX_UNIT="nginx.service"

# --- host facts -------------------------------------------------------------
# The VM's own LAN address. Needed by the networking challenges, which must
# reach the VM as a laptop would rather than over loopback. Leave empty and
# those challenges will tell you to set it.
LAB_LAN_IP=""

# Virtual hosts the host nginx answers on. Invented names under .invalid, which
# is reserved and can never resolve publicly. Put them in /etc/hosts on the VM
# and on your laptop, pointing at LAB_LAN_IP. See SETUP.md section 8.
STAGES_VHOST="stages.lab.invalid"
LEAVES_VHOST="conge.lab.invalid"
NURSE_VHOST="theses.lab.invalid"

# --- seed volumes -----------------------------------------------------------
# Why these numbers: SETUP.md section 9. Shrink them on a small VM, but read
# that section first — s9-02 and s9-03 stop being measurable below roughly a
# tenth of SEED_PLACEMENTS.
SEED_TRAINEES="400"
SEED_PLACEMENTS="60000"
SEED_AUDIT="5000"
SEED_THESES="3000"
SEED_LEAVE_REQUESTS="60"

# Bulk seed targets, pinned to the models these two repos actually ship.
#   leaves v3.0  project leave_management_project, app leave_management
#   nurse        project config, app theses
# seed.sh still falls back to introspection, and still prints every model it
# found and stops rather than guessing, if a tag moves these.
LEAVES_SEED_MODEL="LeaveRequest"
NURSE_SEED_MODEL="Thesis"

# WSGI entry points, which differ between the two.
LEAVES_WSGI="leave_management_project.wsgi:application"
NURSE_WSGI="config.wsgi:application"

# --- paths and endpoints the stage 3 challenges need ------------------------
# Verify these against your VM after SETUP.md; they are the only things the
# stage 3 checks assume about where configuration lives.
LEAVES_ENV="/etc/leaves/leaves.env"          # EnvironmentFile= of the unit
LEAVES_STATIC_ROOT="/opt/leaves/staticfiles" # STATIC_ROOT after collectstatic
LEAVES_CSS="static/admin/css/base.css"       # relative to LEAVES_URL; Django always ships it
NURSE_ENV="/opt/nurse/.env"                  # env_file: of the compose stack
NURSE_LIST="http://localhost:8000/api/theses/"   # the list endpoint; confirm the route
STAGES_UPLOADS_VOLUME="stages_uploads"       # docker volume name, from `docker volume ls`
DEV_USER="dev1"                              # the over-privileged account in s3-07

# How long any single assertion may take before it is failed as timed out.
# A hang is a drill abandoned; a failure is information. Raise it on a slow VM.
ASSERT_TIMEOUT="30"

# --- bounded filesystems for the stage 5 resource drills --------------------
# The exhaustion challenges run on their own loopback filesystems so a break
# cannot fill a volume that matters, and so reset is a reformat rather than a
# traversal. lib/fs.sh creates and destroys these on demand; nothing persists
# between challenges except the empty filesystem a reset leaves mounted. Each
# brief names the mount it affects.
LAB_SCRATCH_DIR="/var/lib/breakfix-lab"      # where the images live
LAB_SCRATCH_MNT="/srv/lab-scratch"           # parent of every lab mount point
S5_UPLOADS_MB="512"                          # s5-01: the filesystem that fills
S5_LOGS_MB="512"                             # s5-03: the log volume
S5_SPOOL_MB="64"                             # s5-02: small, and starved of...
S5_SPOOL_INODES="2048"                       # ...inodes, so it exhausts in seconds
S5_SURVIVE_SECONDS="180"                     # s5-04: the window the app must survive
S5_MEM_FLOOR_MB="256"                        # s5-04: a memory limit below this is the fault
S5_HOG_MB="256"                              # s5-04: the red herring, bounded so it cannot eat the host
S5_HOG_NAME="indexer-warmup"                 # s5-04: the name it runs under
S5_SPIN_NAME="apt-cache-gen"                 # s5-05: the name the loops run under
LEAVES_PORT="8081"                           # s5-06: the port the service must own
S5_DECOY_NAME="telemetry-agent"              # s5-06: the name the squatter runs under
NGINX_SITE="/etc/nginx/sites-available/lab"  # s5-08: the host nginx site file
LAB_JOB_DIR="/opt/lab-jobs"                  # s5-09: where the nightly job lives
LAB_JOB_OUT="/var/lib/lab-jobs/report.csv"   # s5-09: what it is supposed to produce
LAB_JOB_MAX_AGE_H="30"                       # s5-09: older than this is "stopped"
FSTAB="/etc/fstab"                           # s5-07: named so nothing hard-codes it

# Port the throwaway smoke-test challenge serves on. Any free high port.
SMOKE_PORT="18099"
